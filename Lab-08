# ==============>Exercise 6 — Locate a Table Cell with XPath <==============

try:
    driver.get("https://www.w3schools.com/html/html_tables.asp")

    # 2nd <td> inside the 3rd <tr> of the first HTML table
    cell = driver.find_element(By.XPATH, "(//table[1]//tr[3]/td[2])[1]")
    print("Cell text (3rd row, 2nd cell):", cell.text)
finally:
    driver.quit()
